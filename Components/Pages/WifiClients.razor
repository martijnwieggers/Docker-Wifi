@page "/wifi-clients"
@using Docker_Wifi.Models
@using Docker_Wifi.Services
@rendermode InteractiveServer

@inject WifiStateContainer StateContainer
@inject IAccessPointClientService ClientService
@inject ILogger<WifiClients> Logger

@implements IDisposable

<PageTitle>Connected Clients</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3>Connected Clients (wlan1 AP)</h3>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="RefreshClients" disabled="@_isRefreshing">
                @if (_isRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (_state.Clients.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <span>No clients currently connected to the access point.</span>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <strong>@_state.Clients.Count</strong> client(s) connected
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>MAC Address</th>
                            <th>IP Address</th>
                            <th>Hostname</th>
                            <th>Signal</th>
                            <th>TX Rate</th>
                            <th>RX Rate</th>
                            <th>Connected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in _state.Clients)
                        {
                            <tr>
                                <td>
                                    <code class="text-dark">@client.MacAddress</code>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.IpAddress))
                                    {
                                        <code class="text-primary">@client.IpAddress</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.Hostname))
                                    {
                                        <span>@client.Hostname</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </td>
                                <td>
                                    @if (client.SignalDbm.HasValue)
                                    {
                                        <span class="badge @GetSignalBadgeClass(client.SignalDbm.Value)">
                                            @client.SignalDbm.Value dBm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.TxBitrate))
                                    {
                                        <small>@client.TxBitrate</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.RxBitrate))
                                    {
                                        <small>@client.RxBitrate</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (client.ConnectedDuration.HasValue)
                                    {
                                        <small>@FormatDuration(client.ConnectedDuration.Value)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <small class="text-muted">
                Last updated: @_state.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </small>
        </div>
    }
</div>

@code {
    private WifiState _state = new();
    private bool _isRefreshing;

    protected override void OnInitialized()
    {
        _state = StateContainer.State;
        StateContainer.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _state = StateContainer.State;
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshClients()
    {
        try
        {
            _isRefreshing = true;
            StateHasChanged();

            var clients = await ClientService.GetConnectedClientsAsync();
            await StateContainer.UpdateClientsAsync(clients);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh clients");
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private static string GetSignalBadgeClass(int signalDbm)
    {
        // Signal strength classification (dBm)
        // Excellent: -30 to -50
        // Good: -50 to -60
        // Fair: -60 to -70
        // Weak: -70 to -80
        // Poor: < -80

        return signalDbm switch
        {
            >= -50 => "bg-success",
            >= -60 => "bg-primary",
            >= -70 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
        {
            return $"{(int)duration.TotalDays}d {duration.Hours}h";
        }
        else if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        }
        else if (duration.TotalMinutes >= 1)
        {
            return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        }
        else
        {
            return $"{duration.Seconds}s";
        }
    }

    public void Dispose()
    {
        StateContainer.OnStateChanged -= OnStateChanged;
    }
}
